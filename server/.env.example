# Everything here is OPTIONAL. With this file empty the app still runs end to end:
# embeddings fall back to a deterministic offline method and narration to a
# deterministic template. Keys only upgrade the prose and enable live Connect.

# --- database -----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/kpi_storytelling
PORT=4000

# --- narration + embeddings (pick ONE; Gemini wins if both are set) -----------
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=text-embedding-004

# OpenAI is paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- live "Connect a company" sources (set any; all have free tiers) ----------
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# https://gnews.io          — free tier, personal email accepted
GNEWS_API_KEY=
# https://newsapi.org       — free tier, signup requires a work email
NEWSAPI_KEY=
